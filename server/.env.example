# CloudDrop სერვერის კონფიგურაცია
PORT=5000

# ფაილის მაქსიმალური დასაშვები ზომა მეგაბაიტებში (MB) - 20480 MB = 20 GB
MAX_FILE_SIZE_MB=20480

# საცავის ტიპი: 'local' (ლოკალური დისკი) ან 'supabase' (Supabase Cloud Storage)
STORAGE_TYPE=local

# Supabase კონფიგურაცია (საჭიროა მხოლოდ მაშინ, თუ STORAGE_TYPE=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_BUCKET=files
